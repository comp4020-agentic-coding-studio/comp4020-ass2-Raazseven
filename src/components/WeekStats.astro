---
// A third shared visual, alongside WeekDiagram and SeminarAgenda: not the
// timeline's shape, and not the room's runsheet, but the week's scale — 2-4
// stat callouts, grounded in the week's own numbers where they exist, or in
// the course's own resolution vocabulary where they don't, so every week
// gets the same kind of panel even when the case itself has no digits.
interface Stat {
  value: string;
  label: string;
}

interface Props {
  /** Accessible name and caption; same contract as WeekDiagram's title. */
  title: string;
  /** 2-4 entries. */
  stats: Stat[];
}

const { title, stats } = Astro.props as Props;
const summary = stats.map((s) => `${s.value}, ${s.label}`).join("; ");
---

<figure class="week-stats">
  <div class="ws-grid" role="img" aria-label={`${title}: ${summary}`}>
    {
      stats.map((s) => (
        <div class="ws-tile">
          <span class="ws-value">{s.value}</span>
          <span class="ws-label">{s.label}</span>
        </div>
      ))
    }
  </div>
  <figcaption>{title}</figcaption>
</figure>

<style>
  .week-stats {
    margin: 1.5rem auto;
    max-width: 64rem;
  }

  .ws-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .ws-tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0.6rem;
    border: 1px solid var(--at-text-secondary, #555);
    background: color-mix(in srgb, var(--at-accent, #a6321f) 10%, transparent);
  }

  .ws-value {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--at-accent, #a6321f);
    line-height: 1.1;
  }

  .ws-label {
    font-size: 1.2rem;
    color: var(--at-text-secondary, #555);
    line-height: 1.3;
  }

  figcaption {
    font-size: 1.6rem;
    color: var(--at-text-secondary, #555);
    margin-top: 1rem;
    text-align: center;
  }
</style>
