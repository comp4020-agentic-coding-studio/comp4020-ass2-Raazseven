---
// A second shared visual, alongside WeekDiagram: not the course's argument,
// but the shape of the two hours in the room. Every week uses the same six
// segments in the same order and (mostly) the same minutes, so the runsheet
// itself becomes something students recognise week to week, the same way
// WeekDiagram's marks do.
interface Segment {
  label: string;
  minutes: number;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props as Props;
const total = segments.reduce((sum, s) => sum + s.minutes, 0);
const summary = segments.map((s) => `${s.label}, ${s.minutes} minutes`).join("; ");
---

<figure class="seminar-agenda">
  <div class="sa-rows" role="img" aria-label={`Seminar runsheet: ${summary}`}>
    {
      segments.map((seg) => (
        <div class="sa-row">
          <div class="sa-fill" style={`width: ${(seg.minutes / total) * 100}%;`} />
          <span class="sa-label">{seg.label}</span>
          <span class="sa-minutes">{seg.minutes} min</span>
        </div>
      ))
    }
  </div>
  <figcaption>~{total} minutes, start to finish</figcaption>
</figure>

<style>
  .seminar-agenda {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  .sa-rows {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .sa-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-radius: 0.6rem;
    border: 1px solid var(--at-text-secondary, #555);
    overflow: hidden;
  }

  .sa-fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: color-mix(in srgb, var(--at-accent, #a6321f) 38%, transparent);
    z-index: 0;
  }

  .sa-label {
    position: relative;
    z-index: 1;
    flex: 1;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .sa-minutes {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    font-size: 1.1rem;
    opacity: 0.8;
  }

  figcaption {
    font-size: 1.1rem;
    color: var(--at-text-secondary, #555);
    text-align: center;
  }
</style>
